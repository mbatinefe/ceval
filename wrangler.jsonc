{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ceval",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "migrations": [
    { "tag": "scan-processor-v1", "new_sqlite_classes": ["ScanProcessor"] },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "invocation_logs": false,
    },
  },
  "env": {
    "staging": {
      "name": "ceval-staging",
      "workers_dev": true,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [{ "name": "SCANS", "class_name": "ScanProcessor" }],
      },
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": [
          "/",
          "/signin",
          "/app",
          "/app/*",
          "/api/*",
          "/demo/walkthroughs/electronics-walkthrough.mp4",
          "/demo/walkthroughs/secondhand-walkthrough.mp4",
        ],
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "RESEND_API_KEY", "AUTH_EMAIL_FROM"],
      },
      "vars": {
        "APP_ENVIRONMENT": "staging",
        "SIGNUPS_ENABLED": "false",
        "SCAN_ENABLED": "false",
        "SCAN_TOTAL_BUDGET_MICROS": "100000000",
        "EMAIL_DAILY_LIMIT": "10",
        "BETTER_AUTH_URL": "https://ceval-staging.mbefe34.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ceval-staging",
          "database_id": "33067d83-0155-4c29-8bc8-2a880726a6c6",
          "migrations_dir": "db/d1/migrations",
        },
      ],
    },
    "production": {
      "name": "ceval",
      "workers_dev": true,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [{ "name": "SCANS", "class_name": "ScanProcessor" }],
      },
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": [
          "/",
          "/signin",
          "/app",
          "/app/*",
          "/api/*",
          "/demo/walkthroughs/electronics-walkthrough.mp4",
          "/demo/walkthroughs/secondhand-walkthrough.mp4",
        ],
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "RESEND_API_KEY", "AUTH_EMAIL_FROM"],
      },
      "vars": {
        "APP_ENVIRONMENT": "production",
        "SIGNUPS_ENABLED": "true",
        "SCAN_ENABLED": "true",
        "SCAN_TOTAL_BUDGET_MICROS": "100000000",
        "EMAIL_DAILY_LIMIT": "70",
        "BETTER_AUTH_URL": "https://ceval.mbefe34.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ceval-production",
          "database_id": "47c7a73b-3692-4a3c-a14d-b893cffa59af",
          "migrations_dir": "db/d1/migrations",
        },
      ],
    },
  },
}
