{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ceval",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "invocation_logs": false,
    },
  },
  "env": {
    "staging": {
      "name": "ceval-staging",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": ["/", "/signin", "/app", "/app/*", "/api/*"],
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "RESEND_API_KEY",
          "AUTH_EMAIL_FROM",
          "META_API_KEY",
        ],
      },
      "vars": {
        "APP_ENVIRONMENT": "staging",
        "SCAN_ENABLED": "false",
        "SCAN_DAILY_BUDGET_MICROS": "10000000",
        "SCAN_TOTAL_BUDGET_MICROS": "100000000",
        "EMAIL_DAILY_LIMIT": "10",
        "BETTER_AUTH_URL": "https://ceval-staging.mbefe34.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ceval-staging",
          "database_id": "33067d83-0155-4c29-8bc8-2a880726a6c6",
          "migrations_dir": "db/d1/migrations",
        },
      ],
    },
  },
}
