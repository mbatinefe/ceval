{
  "name": "ceval",
  "version": "0.0.0",
  "private": true,
  "description": "Camera-based shopping and resale comparisons.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mbatinefe/ceval.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "cf:login": "wrangler login --device --use-keyring",
    "cf:types": "wrangler types .wrangler/worker-configuration.d.ts --env staging",
    "typecheck": "npm run cf:types && tsc --noEmit && tsc -p tsconfig.client.json",
    "check:deploy": "npm run build && wrangler deploy --env staging --dry-run",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "test": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "build": "vite build",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.json\" \"*.jsonc\" \"*.ts\" index.html",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "check:production": "npm run build && wrangler deploy --env production --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "miniflare": "^5.20261023.2-beta",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.155.0"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "hono": "^4.13.14",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
