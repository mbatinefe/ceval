# Local server configuration. Copy to .dev.vars and supply your own credentials.
# Deployed credentials belong in Cloudflare Worker secrets.
META_API_KEY=
BETTER_AUTH_SECRET=

# Transactional email: use a sending-only key scoped to the verified domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Set to the exact deployed HTTPS origin for the selected environment.
BETTER_AUTH_URL=

# Optional image search. Uploads product crops to SerpApi for Google Lens.
# Credentials remain server-side; default hosted search limit is 200/month.
SERPAPI_API_KEY=
