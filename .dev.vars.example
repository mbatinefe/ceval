# npm run dev creates .dev.vars.local automatically with a random auth secret.
# Edit that ignored file to supply your own Meta API key for live analysis.
# No Cloudflare account or Resend key is needed for the local application.
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
META_API_KEY=""

# Local origin and environment are defined in wrangler.local.jsonc.
# Local sign-in codes appear in the terminal without an email address.
# Hosted deployments use Worker secrets for BETTER_AUTH_SECRET,
# META_API_KEY, RESEND_API_KEY and AUTH_EMAIL_FROM (your own verified sender).
